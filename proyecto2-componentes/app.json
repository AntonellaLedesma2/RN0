{
  "expo": {
    "name": "proyecto2-componentes",
    "slug": "proyecto2-componentes",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "proyecto2componentes",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#0F172A" }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
